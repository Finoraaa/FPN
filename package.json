{
  "name": "fpn-vpn",
  "version": "1.1.0",
  "description": "FPN - Freedom Private Network Desktop Application",
  "main": "main.js",
  "author": {
    "name": "Finoraaa",
    "email": "Finoraaa@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "app": "electron .",
    "server": "node client/server.js",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.freedom.fpn",
    "productName": "FPN",
    "publish": {
      "provider": "github",
      "owner": "Finoraaa",
      "repo": "FPN"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "client/**/*",
      "bin/**/*",
      "scripts/**/*"
    ],
    "asarUnpack": [
      "bin/**/*",
      "scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "linux": {
      "maintainer": "Finoraaa <Finoraaa@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "client/public/img/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "client/public/img/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "client/public/img/icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

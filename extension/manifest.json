{
  "manifest_version": 3,
  "name": "FPN - Freedom Private Network",
  "version": "1.0.5",
  "description": "Sansürsüz, Hızlı ve Güvenli Özgür İnternet Eklentisi. Tek tıkla engelleri aşın.",
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FPN - Freedom Private Network",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fpn-vpn@freedom.network",
      "strict_min_version": "109.0"
    }
  }
}
